# ================================================
# TipStream Pro - Contract Configuration
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ------------------------------------------------
# Deployer Wallet
# ------------------------------------------------
# Private key for contract deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# ------------------------------------------------
# Network RPC URLs
# ------------------------------------------------
# Base Mainnet
BASE_MAINNET_RPC=https://mainnet.base.org

# Base Sepolia (Testnet)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Local development (Anvil)
LOCAL_RPC=http://localhost:8545

# ------------------------------------------------
# Block Explorer API Keys
# ------------------------------------------------
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key

# ------------------------------------------------
# Contract Addresses (filled after deployment)
# ------------------------------------------------
TIP_NFT_ADDRESS=
TIP_STREAM_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=
DAILY_CHECKIN_ADDRESS=

# ------------------------------------------------
# Contract Settings
# ------------------------------------------------
# Platform fee in basis points (100 = 1%)
PLATFORM_FEE_BPS=100

# Minimum tip amount in wei
MIN_TIP_AMOUNT=1000000000000000

# NFT metadata base URI
NFT_BASE_URI=https://tipstream.app/api/nft/

# ------------------------------------------------
# Admin/Owner Settings
# ------------------------------------------------
# Address to receive platform fees
FEE_RECIPIENT=0x...

# Multi-sig or admin address (optional)
ADMIN_ADDRESS=